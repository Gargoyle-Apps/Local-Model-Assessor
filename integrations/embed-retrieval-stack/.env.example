# Copy to .env and adjust. Used by docker compose and handoff samples.
# POSTGRES_PASSWORD is required — compose will fail without it.

POSTGRES_USER=lma
POSTGRES_PASSWORD=change_me_before_first_run
POSTGRES_DB=lma
POSTGRES_PORT=5432

# App connection string (host is localhost when connecting from the host machine)
DATABASE_URL=postgresql://lma:change_me_before_first_run@localhost:5432/lma

# Ollama API (host machine — embed_sample.py defaults here)
OLLAMA_HOST=http://127.0.0.1:11434
